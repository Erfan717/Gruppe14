---
import { site, nav } from '../data/site.js';

/**
 * Toppmenyen.
 *
 * To tilstander:
 *   overlay — ligger gjennomsiktig oppå gruppebildet på forsiden. Bare teksten
 *             synes, bakgrunnsbildet skinner gjennom.
 *   solid   — hvit flate med sort tekst. Dette er utgangspunktet på alle andre
 *             sider, og det forsiden bytter til når du har scrollet forbi bildet.
 *
 * Er overlay=false rendres solid-klassen rett fra serveren, så de sidene
 * trenger ikke JavaScript i det hele tatt.
 */
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

// Gjør at /about og /about/ regnes som samme side.
const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const current = normalize(Astro.url.pathname);
---

<header class:list={['header', { 'is-overlay': overlay, 'is-solid': !overlay }]} data-header>
  <div class="header__inner">
    <a class="logo" href="/" aria-label={`${site.name} — til forsiden`}>
      <span class="logo__mark">{site.mark}</span>
      <span class="logo__word">{site.name}</span>
    </a>

    <nav aria-label="Hovedmeny">
      <ul class="nav">
        {
          nav.map((item) => {
            const isActive = normalize(item.href) === current;
            return (
              <li>
                <a href={item.href} class:list={['nav__link', { 'is-active': isActive }]}
                   aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Headeren blir hvit i det elementet den ligger oppå har scrollet forbi.
  // Elementet merkes med data-header-watch — i praksis gruppebildet på forsiden.
  // Finnes det ikke, gjør dette skriptet ingenting, og headeren blir stående
  // hvit slik den ble rendret fra serveren.
  const header = document.querySelector('[data-header]');
  const watched = document.querySelector('[data-header-watch]');

  if (header && watched) {
    // rootMargin trekker toppen av "vinduet" ned med headerens egen høyde, så
    // byttet skjer nøyaktig når bildet slipper undersiden av headeren.
    const offset =
      parseInt(
        getComputedStyle(document.documentElement).getPropertyValue('--header-height'),
        10
      ) || 76;

    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('is-solid', !entry.isIntersecting);
        header.classList.toggle('is-overlay', entry.isIntersecting);
      },
      { rootMargin: `-${offset}px 0px 0px 0px`, threshold: 0 }
    );

    observer.observe(watched);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-height);
    transition:
      background-color var(--speed-slow) var(--ease),
      color var(--speed-slow) var(--ease),
      border-color var(--speed-slow) var(--ease);
  }

  .header__inner {
    max-width: var(--container);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  /* --- Gjennomsiktig oppa foto --- */
  .header.is-overlay {
    background-color: transparent;
    border-bottom: 1px solid transparent;
    color: var(--text-on-photo);
  }

  /* Svak nedtoning i toppen, sa menyteksten holder seg lesbar uansett
     hvor lyst gruppebildet er akkurat der. */
  .header.is-overlay::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--header-height) * 2.4);
    background: linear-gradient(to bottom, rgba(10, 10, 14, 0.55), transparent);
    pointer-events: none;
  }

  .header.is-overlay .logo__mark {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
    color: var(--text-on-photo);
  }

  /* --- Lys flate --- */
  .header.is-solid {
    background-color: rgba(22, 24, 28, 0.78);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }

  .header.is-solid .logo__mark {
    background: var(--surface);
    border-color: var(--line-strong);
    color: var(--text);
  }

  /* --- Logo --- */
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Merket settes i monospace — den minste tekniske detaljen som likevel
     setter tonen for resten av siden. */
  .logo__mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-code);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    transition:
      background var(--speed-slow) var(--ease),
      border-color var(--speed-slow) var(--ease),
      color var(--speed-slow) var(--ease);
  }

  /* --- Meny --- */
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-sm), 2vw, var(--space-lg));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: var(--space-3xs);
    font-size: var(--text-sm);
    font-weight: 450;
    letter-spacing: -0.005em;
    opacity: 0.72;
    transition:
      opacity var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    opacity: 1;
  }

  /* Tynn strek under den aktive sida, tegnet inn ved hover pa de andre. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--speed) var(--ease);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  /* Aktiv side framheves med lysstyrke, ikke med farge. */
  .header.is-solid .nav__link.is-active,
  .header.is-overlay .nav__link.is-active {
    color: var(--hi);
  }

  @media (max-width: 760px) {
    .logo__word {
      display: none;
    }

    .nav {
      gap: var(--space-sm);
    }

    .nav__link {
      font-size: var(--text-xs);
    }
  }
</style>
