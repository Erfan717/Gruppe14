---
import { stack } from '../data/site.js';

/**
 * Teknologiene gruppa har jobbet med. Dette er det en arbeidsgiver ser etter
 * først, så det får sin egen seksjon i stedet for å ligge gjemt i bioene.
 *
 * Lista ligger i site.js — legg til noe der, så dukker det opp her.
 */
---

<section class="stack">
  <div class="container">
    <p class="label">Verktøy vi kan</p>

    <ul class="stack__grid">
      {
        stack.map((item, i) => (
          <li class="stack__item">
            <span class="stack__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="stack__name">{item.name}</span>
            <span class="stack__note">{item.note}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stack {
    padding-block: var(--space-2xl);
    background: var(--bg);
    border-block: 1px solid var(--line);
  }

  .stack :global(.label) {
    margin-bottom: var(--space-lg);
  }

  /* Rutenett med delte kantlinjer — cellene skal lese som et oppsett,
     ikke som frittstående kort. */
  .stack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .stack__item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'num name'
      'num note';
    align-content: center;
    gap: 0 var(--space-sm);
    padding: var(--space-md);
    background: var(--bg);
    transition: background var(--speed) var(--ease);
  }

  .stack__item:hover {
    background: var(--surface);
  }

  .stack__num {
    grid-area: num;
    align-self: center;
    color: var(--text-faint);
    font-family: var(--font-code);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
  }

  .stack__name {
    grid-area: name;
    color: var(--text);
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .stack__note {
    grid-area: note;
    color: var(--text-faint);
    font-family: var(--font-code);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
  }
</style>
