---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VideoSection from '../components/VideoSection.astro';
---

<BaseLayout
  title="Gruppe 14"
  description="Fem bachelorstudenter ved Universitetet i Agder som bygger digitale løsninger med en tydelig hensikt."
  overlayHeader
>
  <Hero />
  <VideoSection />

  <section class="section next">
    <div class="container next__inner">
      <div>
        <p class="label">Veien videre</p>
        <h2>Ulike styrker.<br />Felles retning.</h2>
      </div>
      <div>
        <p class="prose">
          Vi ser etter et prosjekt der vi kan kombinere kunnskapen fra studiet med en reell
          problemstilling. Vi er åpne for ulike typer prosjekter og bedrifter, men ønsker
          gjerne å utvikle en digital løsning som skaper verdi for brukerne eller bedriften.
        </p>
        <div class="next__actions">
          <a class="button" href="/about/">Bli kjent med oss</a>
          <a class="button button--quiet" href="/contact/">Ta kontakt</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .next {
    background: var(--bg-raised);
    border-top: 1px solid var(--line);
  }

  .next__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  @media (max-width: 760px) {
    .next__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
