export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
  /** Synlig etikett for skjermlesere. Utelat når ikonet står ved siden av tekst. */
  label?: string;
}

const { name, size = 20, label } = Astro.props;
const path = paths[name];
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {label && <title>{label}</title>}
  <path d={path} />
</svg>
