---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

/**
 * Lenkeraden på et personkort. Tar imot links-objektet fra team.js og hopper
 * over de som mangler, så et medlem uten GitHub bare får færre ikoner.
 */
interface Props {
  links: Partial<Record<'github' | 'linkedin' | 'website', string>>;
  /** Navnet brukes i aria-label, så skjermlesere hører hvem lenka gjelder. */
  person: string;
}

const { links, person } = Astro.props;

const labels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  website: 'Nettside',
};

const entries = (Object.keys(labels) as IconName[])
  .filter((key) => Boolean(links[key as keyof Props['links']]))
  .map((key) => ({
    key,
    href: links[key as keyof Props['links']] as string,
    label: labels[key],
  }));
---

{
  entries.length > 0 && (
    <ul class="social">
      {entries.map(({ key, href, label }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${label} — ${person}`}
          >
            <Icon name={key} size={18} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    list-style: none;
    padding: 0;
  }

  a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    transition:
      background var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  a:hover {
    background: var(--steel-dim);
    border-color: var(--line-strong);
    color: var(--hi);
  }
</style>
