---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { mailtoHref } from '../../data/site.js';

/**
 * Prosjektsiden står bevisst tom.
 *
 * Den forrige versjonen viste to oppdiktede prosjekter («Prosjekt Aurora»,
 * «Prosjekt Kompass») med lånte bilder fra Unsplash. Det ser mer ut som en
 * mal enn som en portefølje, og en bedrift som leser den vil merke det.
 * Heller si ærlig at bacheloroppgaven ikke er valgt ennå — og bruke sida
 * til å invitere inn et prosjekt.
 */
---

<BaseLayout
  title="Prosjekter"
  description="Bachelorprosjektet er ikke valgt ennå. Vi ser etter en reell problemstilling å bryne oss på."
>
  <PageHeader
    label="Det vi lager"
    title="Prosjektet er ikke valgt ennå."
    lead="Vi er i gang med å finne bacheloroppgaven vår, og har plass til én ordentlig problemstilling."
  />

  <section class="section">
    <div class="container looking">
      <div>
        <h2>Hva vi ser etter</h2>
        <p class="prose">
          En reell problemstilling fra en bedrift eller organisasjon, der vi kan kombinere
          kunnskapen fra studiet med noe som faktisk skal brukes av noen. Vi er åpne for ulike
          typer prosjekter, men ønsker gjerne å utvikle en digital løsning med en tydelig
          hensikt.
        </p>
      </div>

      <ul class="criteria">
        <li>
          <span class="criteria__num">01</span>
          <div>
            <h3>En tydelig hensikt</h3>
            <p>Noe som skaper verdi for brukerne eller for bedriften, ikke en øvelse.</p>
          </div>
        </li>
        <li>
          <span class="criteria__num">02</span>
          <div>
            <h3>Hele veien</h3>
            <p>Fra kartlegging og planlegging til utvikling, testing og ferdig løsning.</p>
          </div>
        </li>
        <li>
          <span class="criteria__num">03</span>
          <div>
            <h3>Rom for fem</h3>
            <p>Bredt nok til at frontend, backend, data og sikkerhet alle får en rolle.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section invite">
    <div class="container container--narrow invite__inner">
      <h2>Har dere en oppgave til oss?</h2>
      <p class="prose">
        Fortell kort hvem dere er og hva dere har på hjertet, så svarer vi så raskt vi kan.
      </p>
      <a class="button" href={mailtoHref}>Send oss en e-post</a>
    </div>
  </section>
</BaseLayout>

<style>
  .looking {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .looking .prose {
    margin-top: var(--space-md);
  }

  .criteria {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .criteria li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .criteria li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .criteria__num {
    padding-top: 0.3em;
    color: var(--text-faint);
    font-family: var(--font-code);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
  }

  .criteria h3 {
    margin-bottom: var(--space-3xs);
    font-size: var(--text-lg);
  }

  .criteria p {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .invite {
    background: var(--bg-raised);
    border-top: 1px solid var(--line);
  }

  .invite__inner {
    text-align: center;
  }

  .invite .prose {
    margin-inline: auto;
    margin-block: var(--space-md) var(--space-lg);
  }

  @media (max-width: 760px) {
    .looking {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
