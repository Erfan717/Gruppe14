---
import { Image } from 'astro:assets';
import SocialLinks from './SocialLinks.astro';

/**
 * Ett personkort. Alle fem genereres fra src/data/team.js, så markupen
 * finnes bare her — ikke fem ganger nedover i about-sida.
 */
interface Props {
  name: string;
  photo?: string | null;
  bio: string[];
  links: Partial<Record<'github' | 'linkedin' | 'website', string>>;
}

const { name, photo, bio, links } = Astro.props;

// Alle profilbildene hentes inn på forhånd, så vi kan slå opp på filnavn.
// Mangler fila, faller vi tilbake til «Bilde kommer» uten at noe knekker.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/team/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const entry = photo
  ? Object.entries(photos).find(([path]) => path.endsWith(`/${photo}`))
  : undefined;
const image = entry?.[1].default;
---

<article class="card">
  <div class="card__photo">
    {
      image ? (
        <Image src={image} alt={`Portrett av ${name}`} widths={[400, 700]} sizes="(max-width: 760px) 90vw, 360px" />
      ) : (
        <span class="card__pending">Bilde kommer</span>
      )
    }
  </div>

  <div class="card__body">
    <h3 class="card__name">{name}</h3>
    {bio.map((paragraph) => <p class="card__bio">{paragraph}</p>)}
    <SocialLinks links={links} person={name} />
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: 0 18px 40px -28px rgba(16, 16, 20, 0.45);
  }

  .card__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  .card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__pending {
    color: var(--text-faint);
    font-family: var(--font-code);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .card__name {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .card__bio {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  /* Lenkene skyves til bunnen, saa de staar paa linje paa tvers av kortene. */
  .card :global(.social) {
    margin-top: auto;
    padding-top: var(--space-2xs);
  }
</style>
