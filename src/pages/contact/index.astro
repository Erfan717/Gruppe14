---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { site, mailtoHref } from '../../data/site.js';

/**
 * Kontaktsiden har med vilje ikke noe skjema.
 *
 * Et skjema som virker trenger en server til å holde en API-nøkkel for
 * e-postutsending. Dette prosjektet har ingen backend, og skal ikke ha det.
 * mailto-lenka ER den fungerende løsningen — den åpner besøkendes eget
 * e-postprogram med emnefeltet ferdig utfylt.
 */
const reasons = [
  {
    title: 'Samarbeid om et prosjekt',
    body: 'Har dere en problemstilling som fortjener friske øyne? Vi er på jakt etter en bacheloroppgave.',
  },
  {
    title: 'Praksis og jobb',
    body: 'Vi nærmer oss slutten av studiet, og hører gjerne fra bedrifter som trenger nysgjerrige folk.',
  },
  {
    title: 'Bare et spørsmål',
    body: 'Lurer du på hvordan vi jobber, eller hvem vi er? Spør i vei — det koster deg to minutter.',
  },
];
---

<BaseLayout
  title="Kontakt"
  description="Ta kontakt med Gruppe 14 på e-post. Vi hører gjerne fra bedrifter, samarbeidspartnere og andre nysgjerrige."
>
  <section class="hero">
    <div class="container hero__inner">
      <p class="label">Kontakt</p>
      <h1>En god samtale<br />kan starte her.</h1>

      <a class="mail" href={mailtoHref}>
        <Icon name="mail" size={22} />
        <span class="mail__address">{site.email}</span>
        <span class="mail__hint">Åpner e-postprogrammet ditt</span>
      </a>

      <p class="hero__note">
        Vi er alltid nysgjerrige på nye mennesker og nye problemstillinger. Fortell kort hvem du
        er og hva du har på hjertet, så svarer vi så raskt vi kan.
      </p>
    </div>
  </section>

  <section class="section reasons">
    <div class="container">
      <h2 class="reasons__title">Hva vil du snakke om?</h2>
      <ul class="reasons__list">
        {
          reasons.map((reason) => (
            <li>
              <h3>{reason.title}</h3>
              <p>{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Toppen ligger dypere enn resten av siden — e-postadressen skal
     vaere det eneste som trekker blikket. */
  .hero {
    position: relative;
    padding-block: clamp(4rem, 2rem + 8vw, 7.5rem);
    background: var(--bg-deep);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-step) 100%;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    max-width: var(--container-narrow);
  }

  .hero :global(.label) {
    margin-bottom: var(--space-md);
  }

  .hero__note {
    max-width: 54ch;
    margin-top: var(--space-xl);
    color: var(--text-muted);
    line-height: var(--leading-loose);
  }

  /* Selve e-postlenka: stor, i monospace — det ER en adresse, saa la den
     se ut som noe man kan kopiere. */
  .mail {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg) var(--space-md) var(--space-md);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    transition:
      border-color var(--speed) var(--ease),
      background var(--speed) var(--ease);
  }

  .mail:hover {
    background: var(--surface-hover);
    border-color: var(--text-faint);
  }

  .mail svg {
    color: var(--text-faint);
    transition:
      transform var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  .mail:hover svg {
    transform: translateX(2px);
    color: var(--text-soft);
  }

  .mail__address {
    font-family: var(--font-code);
    font-size: clamp(1.05rem, 0.85rem + 1vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    word-break: break-all;
  }

  .mail__hint {
    grid-column: 2;
    color: var(--text-faint);
    font-family: var(--font-code);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  /* --- Grunner til aa ta kontakt --- */
  .reasons {
    background: var(--bg);
  }

  .reasons__title {
    margin-bottom: var(--space-lg);
  }

  .reasons__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .reasons__list li {
    padding: var(--space-lg) var(--space-md);
    background: var(--bg);
    transition: background var(--speed) var(--ease);
  }

  .reasons__list li:hover {
    background: var(--surface);
  }

  .reasons__list h3 {
    margin-bottom: var(--space-2xs);
    font-size: var(--text-lg);
  }

  .reasons__list p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
</style>
