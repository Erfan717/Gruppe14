---
/**
 * Vises der et bilde eller en video ennå ikke er lagt inn.
 *
 * Poenget er at siden skal se ferdig ut mens gruppa venter på innholdet —
 * ikke som en ødelagt side. Legges fila inn i src/assets/media/, forsvinner
 * denne av seg selv.
 */
interface Props {
  label: string;
  /** 'light' på hvit bakgrunn, 'dark' oppå en mørk flate. */
  tone?: 'light' | 'dark';
}

const { label, tone = 'light' } = Astro.props;
---

<div class:list={['placeholder', `placeholder--${tone}`]}>
  <div class="placeholder__inner">
    <span class="placeholder__label">{label}</span>
  </div>
</div>

<style>
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* Fint rutenett i stedet for diagonalstriper — samme tekniske spraak
     som resten av siden, og det leses som "med vilje tom". */
  .placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--cell) 1px, transparent 1px),
      linear-gradient(to bottom, var(--cell) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .placeholder--light {
    --cell: rgba(255, 255, 255, 0.04);
    background: var(--bg-raised);
    color: var(--text-muted);
  }

  .placeholder--dark {
    --cell: rgba(255, 255, 255, 0.05);
    background: var(--bg-deep);
    color: var(--text-on-photo-muted);
  }

  .placeholder__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-md);
    text-align: center;
  }

  .placeholder__label {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

</style>
